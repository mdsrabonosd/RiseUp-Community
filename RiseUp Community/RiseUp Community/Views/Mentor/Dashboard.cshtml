@{
    ViewData["Title"] = "Mentor Dashboard - RiseUp";
}

<!-- CDN Links for Bootstrap & Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<style>
    body {
        background: linear-gradient(135deg, #0b1020, #111827, #1e3a8a) !important;
        color: #fff !important;
        font-family: 'Segoe UI', sans-serif;
        min-height: 100vh;
    }

    .glass {
        background: rgba(255, 255, 255, 0.07);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 20px;
    }

    .glass-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
        }

    .gradient-text {
        background: linear-gradient(90deg, #38bdf8, #6366f1, #a855f7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
    }
</style>

<!-- Top Navigation Bar -->
<nav class="navbar navbar-expand-lg border-bottom border-white-10 py-3 sticky-top glass">
    <div class="container">
        <a class="navbar-brand fw-bold fs-3 text-white d-flex align-items-center" href="#">
            <i class="bi bi-rocket-takeoff-fill text-primary me-2"></i>Rise<span class="gradient-text">Up</span>
        </a>
        <div class="d-flex align-items-center gap-3">
            <span class="badge bg-info-subtle text-info border border-info px-3 py-2 rounded-pill">
                <i class="bi bi-person-workspace me-1"></i> Mentor
            </span>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-light rounded-pill px-3 py-1 btn-sm">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </form>
        </div>
    </div>
</nav>

<!-- Main Container -->
<main class="container py-4">

    <!-- Top Banner -->
    <div class="glass p-4 p-md-5 mb-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <span class="badge bg-info bg-opacity-25 text-info px-3 py-2 rounded-pill mb-2">Mentorship Hub</span>
                <h1 class="fw-bold">Guide the Next <span class="gradient-text">Innovators</span></h1>
                <p class="text-white-50 mb-0">Manage incoming session requests, schedule advisory meetings, and review ideas.</p>
            </div>
        </div>
    </div>

    <!-- Stat Cards Row -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="glass glass-card p-4 d-flex align-items-center">
                <div class="stat-icon bg-warning bg-opacity-25 text-warning me-3">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">3</h3>
                    <small class="text-white-50">Pending Requests</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass glass-card p-4 d-flex align-items-center">
                <div class="stat-icon bg-success bg-opacity-25 text-success me-3">
                    <i class="bi bi-calendar-check-fill"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">12</h3>
                    <small class="text-white-50">Sessions Completed</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass glass-card p-4 d-flex align-items-center">
                <div class="stat-icon bg-info bg-opacity-25 text-info me-3">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">8</h3>
                    <small class="text-white-50">Startups Mentored</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Mentorship Requests Section -->
    <div class="glass p-4 mb-4">
        <h4 class="fw-bold mb-4"><i class="bi bi-envelope-open text-primary me-2"></i>Incoming Session Requests</h4>

        <div class="d-flex flex-column gap-3">
            <div class="bg-white bg-opacity-10 p-4 rounded-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h5 class="fw-bold mb-1">Onik (Founder @@ NextGen AI)</h5>
                    <p class="text-white-50 small mb-0">"Need guidance on refining our pitch deck and pricing model for Seed stage."</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-success btn-sm rounded-pill px-3"><i class="bi bi-check-lg me-1"></i> Accept</button>
                    <button class="btn btn-outline-danger btn-sm rounded-pill px-3"><i class="bi bi-x-lg me-1"></i> Decline</button>
                </div>
            </div>
        </div>
    </div>

</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>