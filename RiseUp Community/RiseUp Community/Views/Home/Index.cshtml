<div class="col-lg-6 text-center text-lg-start fade-in-left">

    <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 rounded-pill mb-3 animate-pulse">
        🚀 Welcome to RiseUp
    </span>

    <h1 class="display-3 fw-bold text-white mb-4">
        Welcome, Future
        <span class="gradient-text d-block">
            Founder.
        </span>

        Build • Connect • Grow
    </h1>

    <p class="lead text-white-50 mb-4">
        RiseUp is an all-in-one startup ecosystem where innovative
        <strong class="text-white">Founders</strong>,
        trusted
        <strong class="text-white">Investors</strong>,
        and experienced
        <strong class="text-white">Mentors</strong>
        collaborate to transform ideas into successful businesses.
    </p>

    <div class="d-flex gap-3 flex-wrap">

        <a asp-controller="Account"
           asp-action="Register"
           class="btn btn-primary btn-lg rounded-pill px-5 shadow-glow">

            <i class="bi bi-rocket-takeoff me-2"></i>
            Get Started
        </a>

        <a asp-controller="Home"
           asp-action="About"
           class="btn btn-outline-light btn-lg rounded-pill px-5">

            Learn More
        </a>

    </div>

    <div class="d-flex gap-5 mt-5">

        <div>
            <h3 class="text-primary fw-bold mb-0">@Model.TotalStartups+</h3>
            <small class="text-white-50">Ideas Shared</small>
        </div>

        <div>
            <h3 class="text-success fw-bold mb-0">@Model.TotalInvestors+</h3>
            <small class="text-white-50">Active Investors</small>
        </div>

        <div>
            <h3 class="text-info fw-bold mb-0">@Model.TotalMentors+</h3>
            <small class="text-white-50">Expert Mentors</small>
        </div>

    </div>

</div>
<div class="hero-visual-card p-4 mx-auto floating-animation">

    <div class="welcome-card">

        <div class="icon-circle bg-primary mb-3">
            <i class="bi bi-stars text-white fs-2"></i>
        </div>

        <h3 class="text-white fw-bold">
            Welcome Founder 👋
        </h3>

        <p class="text-white-50">
            Your startup journey starts here.
            Connect with investors,
            receive mentorship,
            and scale your business.
        </p>

    </div>

    <hr class="border-secondary" />

    <div class="row g-3">

        <div class="col-4">

            <div class="role-pill">

                <i class="bi bi-lightbulb-fill text-warning fs-2"></i>

                <div>
                    <strong>Founder</strong>
                    <small>Create Startup</small>
                </div>

            </div>

        </div>

        <div class="col-4">

            <div class="role-pill">

                <i class="bi bi-cash-stack text-success fs-2"></i>

                <div>
                    <strong>Investor</strong>
                    <small>Fund Ideas</small>
                </div>

            </div>

        </div>

        <div class="col-4">

            <div class="role-pill">

                <i class="bi bi-person-workspace text-info fs-2"></i>

                <div>
                    <strong>Mentor</strong>
                    <small>Guide Founders</small>
                </div>

            </div>

        </div>

    </div>

</div>
body{

background:
radial-gradient(circle at top left,#3b82f6 0%,transparent 30%),
radial-gradient(circle at bottom right,#8b5cf6 0%,transparent 35%),
#09090b;

overflow-x:hidden;

}