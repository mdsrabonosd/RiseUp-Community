@model RiseUp.Web.Models.LandingViewModel
@{
    ViewData["Title"] = "RiseUp";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
            body {
                margin: 0;
                background: linear-gradient(135deg,#0b1020,#111827,#1e3a8a);
                color: #fff;
                font-family: Segoe UI,sans-serif
            }

            .hero {
                min-height: 100vh;
                display: flex;
                align-items: center
            }

            .glass {
                background: rgba(255,255,255,.08);
                backdrop-filter: blur(12px);
                border: 1px solid rgba(255,255,255,.15);
                border-radius: 22px
            }

            .gradient {
                background: linear-gradient(90deg,#38bdf8,#6366f1,#a855f7);
                -webkit-background-clip: text;
                color: transparent
            }

            .role {
                padding: 18px;
                border-radius: 18px;
                background: rgba(255,255,255,.05);
                transition: .3s
            }

                .role:hover {
                    transform: translateY(-6px)
                }

            .stat {
                font-size: 2rem;
                font-weight: bold
            }

            footer {
                border-top: 1px solid rgba(255,255,255,.15)
            }
    </style>
</head>
<body>
    <div class="container hero">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="badge bg-primary mb-3">🚀 Welcome to RiseUp</span>
                <h1 class="display-3 fw-bold">Welcome Future <span class="gradient">Founder</span></h1>
                <p class="lead text-light">Connect with Investors, Mentors and build your startup faster than ever.</p>
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg rounded-pill me-2">Get Started</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg rounded-pill">Login</a>
                <div class="row mt-5">
                    <div class="col"><div class="stat">@Model.TotalStartups+</div><small>Startups</small></div>
                    <div class="col"><div class="stat">@Model.TotalInvestors+</div><small>Investors</small></div>
                    <div class="col"><div class="stat">@Model.TotalMentors+</div><small>Mentors</small></div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="glass p-4">
                    <h3>Live Startup Ecosystem</h3>
                    <p>Everything you need in one place.</p>
                    <div class="row g-3">
                        <div class="col-md-4"><div class="role text-center"><i class="bi bi-lightbulb-fill fs-1 text-warning"></i><h5>Founder</h5><p>Create startup profile</p></div></div>
                        <div class="col-md-4"><div class="role text-center"><i class="bi bi-cash-stack fs-1 text-success"></i><h5>Investor</h5><p>Fund innovation</p></div></div>
                        <div class="col-md-4"><div class="role text-center"><i class="bi bi-person-workspace fs-1 text-info"></i><h5>Mentor</h5><p>Guide founders</p></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <section class="container py-5">
        <h2 class="text-center mb-5">Why RiseUp?</h2>
        <div class="row g-4">
            <div class="col-md-3"><div class="glass p-4 h-100"><i class="bi bi-rocket fs-1"></i><h5>Launch</h5><p>Share your startup idea.</p></div></div>
            <div class="col-md-3"><div class="glass p-4 h-100"><i class="bi bi-search fs-1"></i><h5>Discover</h5><p>Find mentors & investors.</p></div></div>
            <div class="col-md-3"><div class="glass p-4 h-100"><i class="bi bi-people fs-1"></i><h5>Network</h5><p>Build valuable connections.</p></div></div>
            <div class="col-md-3"><div class="glass p-4 h-100"><i class="bi bi-graph-up-arrow fs-1"></i><h5>Grow</h5><p>Scale your business.</p></div></div>
        </div>
    </section>
    <footer class="py-4 text-center">
        <p>© @DateTime.Now.Year RiseUp - Connect • Innovate • Grow</p>
    </footer>
</body></html>