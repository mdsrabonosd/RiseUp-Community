@{
    ViewData["Title"] = "Founder Dashboard - RiseUp";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Founder Dashboard - RiseUp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
            body {
                background: linear-gradient(135deg, #0b1020, #111827, #1e3a8a);
                color: #fff;
                font-family: 'Segoe UI', sans-serif;
                min-height: 100vh;
            }

            .glass {
                background: rgba(255, 255, 255, 0.07);
                backdrop-filter: blur(14px);
                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 20px;
            }

            .glass-card {
                transition: transform 0.3s ease, box-shadow 0.3s ease;
            }

                .glass-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
                }

            .gradient-text {
                background: linear-gradient(90deg, #38bdf8, #6366f1, #a855f7);
                -webkit-background-clip: text;
                color: transparent;
            }

            .shadow-glow {
                box-shadow: 0 0 15px rgba(99, 102, 241, 0.4);
                transition: box-shadow 0.3s ease;
            }

                .shadow-glow:hover {
                    box-shadow: 0 0 25px rgba(99, 102, 241, 0.7);
                }

            .stat-icon {
                width: 52px;
                height: 52px;
                border-radius: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.6rem;
            }

            .form-control-custom {
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.2);
                color: #fff !important;
                border-radius: 12px;
                padding: 10px 14px;
            }

                .form-control-custom option {
                    background-color: #111827; /* মোডালের ডার্ক ব্যাকগ্রাউন্ডের সাথে ম্যাচিং */
                    color: #fff;
                }

                .form-control-custom:focus {
                    background: rgba(255, 255, 255, 0.15);
                    border-color: #38bdf8;
                    box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
                    outline: none;
                }

                .form-control-custom::placeholder {
                    color: rgba(255, 255, 255, 0.4);
                }

            .modal-glass {
                background: #111827;
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 20px;
            }

            .nav-pills .nav-link {
                color: rgba(255,255,255,0.7);
                border-radius: 12px;
                padding: 10px 20px;
            }

                .nav-pills .nav-link.active {
                    background: linear-gradient(90deg, #6366f1, #a855f7);
                    color: #fff;
                }
    </style>
</head>
<body>

    <!-- Header Navbar -->
    <nav class="navbar navbar-expand-lg border-bottom border-white-10 py-3 sticky-top glass">
        <div class="container">
            <a class="navbar-brand fw-bold fs-3 text-white d-flex align-items-center" href="#">
                <i class="bi bi-rocket-takeoff-fill text-primary me-2"></i>Rise<span class="gradient-text">Up</span>
            </a>

            <div class="d-flex align-items-center gap-3">
                <!-- Notifications -->
                <button class="btn btn-outline-light rounded-circle position-relative p-2" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-bell-fill"></i>
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end p-2 glass">
                    <li><h6 class="dropdown-header">Notifications</h6></li>
                    <li><a class="dropdown-item small" href="#"><i class="bi bi-cash-stack text-success me-2"></i>Investor Interested in Pitch</a></li>
                    <li><a class="dropdown-item small" href="#"><i class="bi bi-person-check text-info me-2"></i>Mentor accepted request</a></li>
                </ul>

                <!-- Profile Badge -->
                <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 rounded-pill">
                    <i class="bi bi-person-badge-fill me-1"></i> Founder
                </span>

                <!-- Logout -->
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light rounded-pill px-3 py-1 btn-sm">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <!-- Main Container -->
    <main class="container py-4">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show glass text-white mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2 text-success"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Top Banner -->
        <div class="glass p-4 p-md-5 mb-4">
            <div class="row align-items-center">
                <div class="col-md-7">
                    <span class="badge bg-info bg-opacity-25 text-info px-3 py-2 rounded-pill mb-2">Founder Workspace</span>
                    <h1 class="fw-bold">Build & Scale Your <span class="gradient-text">Startup</span></h1>
                    <p class="text-white-50 mb-0">Manage your pitches, discover investors, book mentors, and monitor analytics.</p>
                </div>
                <div class="col-md-5 text-md-end mt-3 mt-md-0 d-flex gap-2 justify-md-content-end">
                    <button class="btn btn-primary rounded-pill px-4 py-2 shadow-glow fw-bold" data-bs-toggle="modal" data-bs-target="#createPitchModal">
                        <i class="bi bi-plus-circle me-1"></i> Pitch Startup
                    </button>
                    <button class="btn btn-outline-light rounded-pill px-3 py-2" data-bs-toggle="modal" data-bs-target="#postIdeaModal">
                        <i class="bi bi-lightbulb me-1"></i> Post Idea
                    </button>
                </div>
            </div>
        </div>

        <!-- 1. Analytics Cards Row -->
        <div class="row g-4 mb-4">
            <div class="col-md-3 col-sm-6">
                <div class="glass glass-card p-4 d-flex align-items-center">
                    <div class="stat-icon bg-primary bg-opacity-25 text-primary me-3">
                        <i class="bi bi-eye-fill"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">142</h3>
                        <small class="text-white-50">Pitch Views</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="glass glass-card p-4 d-flex align-items-center">
                    <div class="stat-icon bg-success bg-opacity-25 text-success me-3">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">4</h3>
                        <small class="text-white-50">Funding Interests</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="glass glass-card p-4 d-flex align-items-center">
                    <div class="stat-icon bg-info bg-opacity-25 text-info me-3">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">3</h3>
                        <small class="text-white-50">Mentors Connected</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="glass glass-card p-4 d-flex align-items-center">
                    <div class="stat-icon bg-warning bg-opacity-25 text-warning me-3">
                        <i class="bi bi-chat-dots-fill"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">12</h3>
                        <small class="text-white-50">Unread Messages</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Navigation Tabs for Key Features -->
        <ul class="nav nav-pills mb-4 glass p-2 justify-content-start gap-2" id="founderTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" id="pitch-tab" data-bs-toggle="tab" data-bs-target="#pitch-content"><i class="bi bi-card-heading me-1"></i> My Pitch & Profile</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="investors-tab" data-bs-toggle="tab" data-bs-target="#investors-content"><i class="bi bi-search me-1"></i> Search Investors</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="mentors-tab" data-bs-toggle="tab" data-bs-target="#mentors-content"><i class="bi bi-person-workspace me-1"></i> Find Mentors</button>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content" id="founderTabContent">

            <!-- TAB 1: Pitch & Profile Overview -->
            <div class="tab-pane fade show active" id="pitch-content">
                <div class="row g-4">
                    <div class="col-lg-8">
                        <div class="glass p-4 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h4 class="fw-bold mb-0"><i class="bi bi-rocket text-primary me-2"></i>Active Startup Pitch</h4>
                                <span class="badge bg-success rounded-pill px-3 py-2">Live On Feed</span>
                            </div>

                            <div class="bg-white bg-opacity-10 p-4 rounded-4 mb-4">
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="bg-primary p-3 rounded-circle text-white fs-3"><i class="bi bi-cpu"></i></div>
                                    <div>
                                        <h4 class="fw-bold mb-0">NextGen AI Analytics</h4>
                                        <small class="text-white-50">SaaS • Artificial Intelligence • Seed Stage</small>
                                    </div>
                                </div>
                                <p class="text-white-50 mb-3">Automating B2B data analytics for early stage startups with predictive AI models.</p>

                                <div class="row text-center g-2 pt-3 border-top border-white-10">
                                    <div class="col-6"><small class="text-white-50 d-block">Target Goal</small><strong>$200,000</strong></div>
                                    <div class="col-6"><small class="text-white-50 d-block">Equity Offered</small><strong>10%</strong></div>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-light rounded-pill btn-sm px-4"><i class="bi bi-pencil me-1"></i> Edit Pitch</button>
                                <button class="btn btn-outline-info rounded-pill btn-sm px-4"><i class="bi bi-upload me-1"></i> Upload Pitch Deck PDF</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="glass p-4 h-100">
                            <h4 class="fw-bold mb-3"><i class="bi bi-cash-stack text-success me-2"></i>Investment Interests</h4>

                            <div class="d-flex flex-column gap-3">
                                <div class="p-3 bg-white bg-opacity-10 rounded-3">
                                    <div class="fw-bold">Apex Capital VC</div>
                                    <small class="text-white-50 d-block">Interested in Seed Round</small>
                                    <button class="btn btn-success btn-sm rounded-pill mt-2 w-100">Accept & Open Chat</button>
                                </div>
                                <div class="p-3 bg-white bg-opacity-10 rounded-3">
                                    <div class="fw-bold">John Doe (Angel)</div>
                                    <small class="text-white-50 d-block">Requested Pitch Deck</small>
                                    <button class="btn btn-outline-light btn-sm rounded-pill mt-2 w-100">Send Pitch Deck</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 2: Search Investors -->
            <div class="tab-pane fade" id="investors-content">
                <div class="glass p-4 mb-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <input type="text" class="form-control form-control-custom" placeholder="Search investors by name, domain or VC firm..." />
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-primary w-100 rounded-pill"><i class="bi bi-search me-1"></i> Search Investors</button>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="glass glass-card p-4 text-center">
                            <i class="bi bi-building fs-1 text-info mb-2 d-block"></i>
                            <h5 class="fw-bold">Venture Tech Partners</h5>
                            <span class="badge bg-info text-dark mb-2">FinTech & AI</span>
                            <p class="text-white-50 small">Ticket Size: $100K - $500K</p>
                            <button class="btn btn-outline-primary rounded-pill btn-sm w-100"><i class="bi bi-send me-1"></i> Send Pitch</button>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="glass glass-card p-4 text-center">
                            <i class="bi bi-person-circle fs-1 text-warning mb-2 d-block"></i>
                            <h5 class="fw-bold">Sarah Jenkins</h5>
                            <span class="badge bg-warning text-dark mb-2">Angel Investor</span>
                            <p class="text-white-50 small">Ticket Size: $25K - $100K</p>
                            <button class="btn btn-outline-primary rounded-pill btn-sm w-100"><i class="bi bi-send me-1"></i> Send Pitch</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 3: Search Mentors -->
            <div class="tab-pane fade" id="mentors-content">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="glass glass-card p-4 d-flex align-items-center justify-content-between">
                            <div>
                                <h5 class="fw-bold mb-1">Dr. Alex Rahman</h5>
                                <small class="text-info d-block mb-2">Ex-Google Senior AI Architect</small>
                                <span class="badge bg-secondary">Product Strategy</span>
                            </div>
                            <button class="btn btn-outline-info rounded-pill btn-sm" data-bs-toggle="modal" data-bs-target="#mentorshipModal">Request Session</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </main>

    <!-- MODAL 1: Create Startup Pitch -->
    <div class="modal fade" id="createPitchModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-glass text-white p-3">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-rocket-takeoff text-primary me-2"></i>Create Startup Pitch</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Founder" asp-action="CreatePitch" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-white-50">Startup Name</label>
                            <input type="text" name="startupTitle" class="form-control form-control-custom" required placeholder="e.g. RiseUp Platform" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-pr-50">Category</label>
                            <select name="category" class="form-select form-control-custom">
                                <option>FinTech</option>
                                <option>EdTech</option>
                                <option>AI / Machine Learning</option>
                                <option>E-Commerce</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white-50">Target Funding ($)</label>
                            <input type="number" name="targetFunding" class="form-control form-control-custom" required placeholder="50000" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white-50">Pitch Description</label>
                            <textarea name="description" class="form-control form-control-custom" rows="3" placeholder="Briefly describe your startup solution..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-glow">Publish Pitch</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 2: Post Idea -->
    <div class="modal fade" id="postIdeaModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-glass text-white p-3">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-lightbulb text-warning me-2"></i>Post Business Idea</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Founder" asp-action="PostIdea" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-white-50">Idea Headline</label>
                            <input type="text" name="ideaTitle" class="form-control form-control-custom" required placeholder="e.g. AI for Smart Farming" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white-50">Summary</label>
                            <textarea name="summary" class="form-control form-control-custom" rows="3" placeholder="Explain the concept..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-glow">Share Idea</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>