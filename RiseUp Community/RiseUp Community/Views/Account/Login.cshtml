@model RiseUp.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Login - RiseUp";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
            body {
                margin: 0;
                background: linear-gradient(135deg,#0b1020,#111827,#1e3a8a);
                color: #fff;
                font-family: 'Segoe UI', sans-serif;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }

            .top-navbar {
                padding: 20px 0;
            }

            .glass {
                background: rgba(255,255,255,.08);
                backdrop-filter: blur(12px);
                border: 1px solid rgba(255,255,255,.15);
                border-radius: 22px;
            }

            .gradient {
                background: linear-gradient(90deg,#38bdf8,#6366f1,#a855f7);
                -webkit-background-clip: text;
                color: transparent;
            }

            .form-control-custom {
                background: rgba(255, 255, 255, 0.06);
                border: 1px solid rgba(255, 255, 255, 0.15);
                color: #fff !important;
                border-radius: 12px;
                padding: 12px 16px;
            }

                .form-control-custom:focus {
                    background: rgba(255, 255, 255, 0.12);
                    border-color: #38bdf8;
                    box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
                    outline: none;
                }

                .form-control-custom::placeholder {
                    color: rgba(255, 255, 255, 0.4);
                }

            .shadow-glow {
                box-shadow: 0 0 15px rgba(99, 102, 241, 0.4);
                transition: box-shadow 0.3s ease;
            }

                .shadow-glow:hover {
                    box-shadow: 0 0 25px rgba(99, 102, 241, 0.7);
                }

            .fade-in-up {
                animation: fadeInUp 0.8s ease-out forwards;
            }

    </style>
</head>
<body>

    <!-- Top Navbar -->
    <header class="top-navbar">
        <div class="container d-flex justify-content-between align-items-center">
            <a asp-controller="Home" asp-action="Index" class="navbar-brand fw-bold fs-3 text-white d-flex align-items-center text-decoration-none">
                <i class="bi bi-rocket-takeoff-fill text-primary me-2"></i>Rise<span class="gradient">Up</span>
            </a>
            <span class="text-white-50">Don't have an account? <a asp-controller="Account" asp-action="Register" class="text-info text-decoration-none ms-1 fw-semibold">Register</a></span>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container my-auto py-4 fade-in-up">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="glass p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-white mb-2">Welcome Back</h2>
                        <p class="text-white-50">Sign in to manage your startup ecosystem.</p>
                    </div>

                    <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" autocomplete="off">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-white-50"></label>
                            <!-- autocomplete="off" যুক্ত করা হয়েছে -->
                            <input asp-for="Email" class="form-control form-control-custom" placeholder="name@example.com" autocomplete="off" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label text-white-50"></label>
                            <!-- autocomplete="new-password" দেওয়া হয়েছে যাতে ব্রাউজার সেভ করা পাসওয়ার্ড ফোর্স না করে -->
                            <input asp-for="Password" class="form-control form-control-custom" placeholder="••••••••" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" style="background-color: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.3);" />
                                <label asp-for="RememberMe" class="form-check-label text-white-50 small"></label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-glow fs-6">
                            Sign In <i class="bi bi-box-arrow-in-right ms-2"></i>
                        </button>
                    </form>

                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="py-3 text-center text-white-50 border-top-0">
        <div class="container">
            <p class="mb-0 small">© @DateTime.Now.Year RiseUp - Connect • Innovate • Grow</p>
        </div>
    </footer>

</body>
</html>