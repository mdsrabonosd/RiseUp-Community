@model RiseUp_Community.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register - RiseUp";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
            body {
                margin: 0;
                background: linear-gradient(135deg, #0b1020, #111827, #1e3a8a);
                color: #fff;
                font-family: 'Segoe UI', sans-serif;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }

            .top-navbar {
                padding: 20px 0;
            }

            .glass {
                background: rgba(255, 255, 255, .08);
                backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, .15);
                border-radius: 22px;
            }

            .gradient {
                background: linear-gradient(90deg, #38bdf8, #6366f1, #a855f7);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
            }

            /* Role Selection Card Styling */
            .role-card {
                padding: 16px 10px;
                border-radius: 16px;
                background: rgba(255, 255, 255, .05);
                border: 2px solid rgba(255, 255, 255, .12);
                cursor: pointer;
                transition: all 0.3s ease;
                text-align: center;
            }

                .role-card:hover {
                    transform: translateY(-4px);
                    background: rgba(255, 255, 255, .12);
                }

                .role-card.active {
                    border-color: #6366f1;
                    background: rgba(99, 102, 241, 0.25);
                    box-shadow: 0 0 15px rgba(99, 102, 241, 0.5);
                }

            /* Custom Input Fields */
            .form-control-custom {
                background: rgba(255, 255, 255, 0.06);
                border: 1px solid rgba(255, 255, 255, 0.15);
                color: #fff !important;
                border-radius: 12px;
                padding: 12px 16px;
            }

                .form-control-custom:focus {
                    background: rgba(255, 255, 255, 0.12);
                    border-color: #38bdf8;
                    box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
                    outline: none;
                }

                .form-control-custom::placeholder {
                    color: rgba(255, 255, 255, 0.4);
                }

            .shadow-glow {
                box-shadow: 0 0 15px rgba(99, 102, 241, 0.4);
                transition: box-shadow 0.3s ease;
            }

                .shadow-glow:hover {
                    box-shadow: 0 0 25px rgba(99, 102, 241, 0.7);
                }


            .fade-in-up {
                animation: fadeInUp 0.8s ease-out forwards;
            }
    </style>
</head>
<body>

    <!-- Top Navbar -->
    <header class="top-navbar">
        <div class="container d-flex justify-content-between align-items-center">
            <a asp-controller="Home" asp-action="Index" class="navbar-brand fw-bold fs-3 text-white d-flex align-items-center text-decoration-none">
                <i class="bi bi-rocket-takeoff-fill text-primary me-2"></i>Rise<span class="gradient">Up</span>
            </a>
            <span class="text-white-50">Already have an account? <a asp-controller="Account" asp-action="Login" class="text-info text-decoration-none ms-1 fw-semibold">Login</a></span>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container my-auto py-4 fade-in-up">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <div class="glass p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-white mb-2">Create Your Account</h2>
                        <p class="text-white-50">Select your role and start your startup journey.</p>
                    </div>

                    <form asp-controller="Account" asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Role Selection -->
                        <div class="mb-4">
                            <label class="form-label text-white fw-semibold mb-3">Select Role</label>
                            <input type="hidden" asp-for="Role" id="selectedRole" value="Founder" />

                            <div class="row g-3">
                                <div class="col-4">
                                    <div class="role-card active" onclick="selectRole('Founder', this)">
                                        <i class="bi bi-lightbulb-fill fs-2 text-warning d-block mb-1"></i>
                                        <span class="fw-bold d-block text-white">Founder</span>
                                        <small class="text-white-50 d-none d-sm-block">Build Startup</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="role-card" onclick="selectRole('Investor', this)">
                                        <i class="bi bi-cash-stack fs-2 text-success d-block mb-1"></i>
                                        <span class="fw-bold d-block text-white">Investor</span>
                                        <small class="text-white-50 d-none d-sm-block">Provide Capital</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="role-card" onclick="selectRole('Mentor', this)">
                                        <i class="bi bi-person-workspace fs-2 text-info d-block mb-1"></i>
                                        <span class="fw-bold d-block text-white">Mentor</span>
                                        <small class="text-white-50 d-none d-sm-block">Guide Team</small>
                                    </div>
                                </div>
                            </div>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <!-- Full Name -->
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label text-white-50">Full Name</label>
                            <input asp-for="FullName" class="form-control form-control-custom" placeholder="e.g. John Doe" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-white-50">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control form-control-custom" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Passwords Section -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label text-white-50">Password</label>
                                <input asp-for="Password" type="password" class="form-control form-control-custom" placeholder="••••••••" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label text-white-50">Confirm Password</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control form-control-custom" placeholder="••••••••" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-glow fs-6">
                            Create Account <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </form>

                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="py-3 text-center text-white-50 border-top-0">
        <div class="container">
            <p class="mb-0 small">© @DateTime.Now.Year RiseUp - Connect • Innovate • Grow</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            function selectRole(roleName, element) {
                document.querySelectorAll('.role-card').forEach(el => el.classList.remove('active'));
                element.classList.add('active');
                document.getElementById('selectedRole').value = roleName;
            }
    </script>
</body>
</html>