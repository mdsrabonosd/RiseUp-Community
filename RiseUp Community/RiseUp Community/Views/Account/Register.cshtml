@model RiseUp.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Join RiseUp - Register";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
            body {
                margin: 0;
                background: linear-gradient(135deg, #0b1020, #111827, #1e3a8a);
                color: #fff;
                font-family: 'Segoe UI', sans-serif;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }

            .top-navbar {
                padding: 20px 0;
            }

            .glass-card {
                background: rgba(255, 255, 255, 0.08);
                backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, 0.15);
                border-radius: 22px;
                box-shadow: 0 15px 35px rgba(0,0,0,0.4);
            }

            .gradient {
                background: linear-gradient(90deg, #38bdf8, #6366f1, #a855f7);
                -webkit-background-clip: text;
                color: transparent;
            }

            /* Role Selection Card Styles */
            .role-option {
                border: 2px solid rgba(255, 255, 255, 0.15);
                border-radius: 16px;
                background: rgba(255, 255, 255, 0.04);
                padding: 16px 12px;
                cursor: pointer;
                transition: all 0.3s ease;
                text-align: center;
            }

                .role-option:hover {
                    background: rgba(255, 255, 255, 0.1);
                    transform: translateY(-3px);
                }

                .role-option.active {
                    border-color: #6366f1;
                    background: rgba(99, 102, 241, 0.2);
                    box-shadow: 0 0 15px rgba(99, 102, 241, 0.5);
                }

            /* Form Inputs Styling */
            .form-control-custom {
                background: rgba(255, 255, 255, 0.06);
                border: 1px solid rgba(255, 255, 255, 0.15);
                color: #fff !important;
                border-radius: 12px;
                padding: 12px 16px;
            }

                .form-control-custom:focus {
                    background: rgba(255, 255, 255, 0.12);
                    border-color: #38bdf8;
                    box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
                    outline: none;
                }

                .form-control-custom::placeholder {
                    color: rgba(255, 255, 255, 0.4);
                }

            .shadow-glow {
                box-shadow: 0 0 15px rgba(99, 102, 241, 0.4);
                transition: box-shadow 0.3s ease;
            }

                .shadow-glow:hover {
                    box-shadow: 0 0 25px rgba(99, 102, 241, 0.7);
                }

            /* Animation */
            .fade-in-up {
                animation: fadeInUp 0.8s ease-out forwards;
            }

            /* keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            } */
    </style>
</head>
<body>

    <!-- Header Navigation -->
    <header class="top-navbar">
        <div class="container d-flex justify-content-between align-items-center">
            <a asp-controller="Home" asp-action="Index" class="navbar-brand fw-bold fs-3 text-white d-flex align-items-center text-decoration-none">
                <i class="bi bi-rocket-takeoff-fill text-primary me-2"></i>Rise<span class="gradient">Up</span>
            </a>
            <span class="text-white-50">Already have an account? <a asp-controller="Account" asp-action="Login" class="text-info text-decoration-none ms-1 fw-semibold">Login</a></span>
        </div>
    </header>

    <!-- Main Registration Container -->
    <main class="container my-auto py-4 fade-in-up">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <div class="glass-card p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-white mb-2">Create Your Account</h2>
                        <p class="text-white-50">Choose your role and join the RiseUp startup network.</p>
                    </div>

                    <form asp-controller="Account" asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- 1. Role Selection Grid -->
                        <div class="mb-4">
                            <label class="form-label text-white fw-semibold mb-3">Select Your Role</label>
                            <input type="hidden" asp-for="UserRole" id="selectedRole" />

                            <div class="row g-3">
                                <div class="col-4">
                                    <div class="role-option active" onclick="selectRole('Founder', this)">
                                        <i class="bi bi-lightbulb-fill fs-2 text-warning d-block mb-1"></i>
                                        <span class="fw-bold d-block text-white">Founder</span>
                                        <small class="text-white-50 d-none d-sm-block">Build & Scale</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="role-option" onclick="selectRole('Investor', this)">
                                        <i class="bi bi-cash-stack fs-2 text-success d-block mb-1"></i>
                                        <span class="fw-bold d-block text-white">Investor</span>
                                        <small class="text-white-50 d-none d-sm-block">Fund Projects</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="role-option" onclick="selectRole('Mentor', this)">
                                        <i class="bi bi-person-workspace fs-2 text-info d-block mb-1"></i>
                                        <span class="fw-bold d-block text-white">Mentor</span>
                                        <small class="text-white-50 d-none d-sm-block">Guide Startups</small>
                                    </div>
                                </div>
                            </div>
                            <span asp-validation-for="UserRole" class="text-danger small"></span>
                        </div>

                        <!-- 2. Inputs Grid -->
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label text-white-50"></label>
                            <input asp-for="FullName" class="form-control form-control-custom" placeholder="e.g. John Doe" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-white-50"></label>
                            <input asp-for="Email" class="form-control form-control-custom" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label text-white-50"></label>
                                <input asp-for="Password" class="form-control form-control-custom" placeholder="••••••••" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label text-white-50"></label>
                                <input asp-for="ConfirmPassword" class="form-control form-control-custom" placeholder="••••••••" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- 3. Submit Button -->
                        <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-glow fs-6">
                            Create Account <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </form>

                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="py-3 text-center text-white-50">
        <div class="container">
            <p class="mb-0 small">© @DateTime.Now.Year RiseUp - Connect • Innovate • Grow</p>
        </div>
    </footer>

    <!-- JavaScript for Role Selection -->
    <script>
            function selectRole(roleName, element) {
                // ১. সব অপশন থেকে 'active' ক্লাস রিমুভ করা
                document.querySelectorAll('.role-option').forEach(el => {
                    el.classList.remove('active');
                });

                // ২. সিলেক্ট করা অপশনে 'active' ক্লাস অ্যাড করা
                element.classList.add('active');

                // ৩. Hidden input ফিল্ডে ভ্যালু সেট করা
                document.getElementById('selectedRole').value = roleName;
            }
    </script>

</body>
</html>