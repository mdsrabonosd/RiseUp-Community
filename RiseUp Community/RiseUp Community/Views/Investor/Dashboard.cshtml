@model IEnumerable<RiseUp_Community.Controllers.InvestorController.PitchModel>
@{
    ViewData["Title"] = "Investor Dashboard - RiseUp";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
            body {
                background: #0b1021;
                color: #fff;
                font-family: 'Segoe UI', sans-serif;
                min-height: 100vh;
            }

            .glass-card {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 16px;
                backdrop-filter: blur(10px);
            }

            .stat-card {
                background: rgba(255, 255, 255, 0.03);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 14px;
                padding: 20px;
            }

            .btn-gradient {
                background: linear-gradient(90deg, #6366f1, #a855f7);
                color: #fff;
                border: none;
            }

                .btn-gradient:hover {
                    background: linear-gradient(90deg, #4f46e5, #9333ea);
                    color: #fff;
                }

            .btn-outline-custom {
                border: 1px solid rgba(255, 255, 255, 0.2);
                color: #fff;
                background: rgba(255, 255, 255, 0.05);
            }

                .btn-outline-custom:hover {
                    background: rgba(255, 255, 255, 0.15);
                    color: #fff;
                }

            .form-control-custom {
                background: rgba(255, 255, 255, 0.06);
                border: 1px solid rgba(255, 255, 255, 0.15);
                color: #fff !important;
                border-radius: 12px;
            }

                .form-control-custom:focus {
                    background: rgba(255, 255, 255, 0.12);
                    border-color: #6366f1;
                    box-shadow: none;
                }

            .cat-badge {
                border-radius: 20px;
                padding: 6px 16px;
                font-size: 13px;
                text-decoration: none;
                color: #fff;
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 255, 255, 0.15);
            }

                .cat-badge.active, .cat-badge:hover {
                    background: #6366f1;
                    border-color: #6366f1;
                    color: #fff;
                }
    </style>
</head>
<body>

    <div class="container py-4">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show glass-card text-white mb-4">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Header Banner -->
        <div class="glass-card p-4 p-md-5 mb-4">
            <span class="badge bg-success bg-opacity-20 text-success border border-success rounded-pill px-3 py-1 mb-2">Dealflow Center</span>
            <h1 class="fw-bold fs-2">Explore Promising <span class="text-primary">Startups</span></h1>
            <p class="text-white-50 mb-0">Discover high-potential pitches, request pitch decks, and manage investments.</p>
        </div>

        <!-- Stats Row -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="stat-card d-flex align-items-center gap-3">
                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 fs-3"><i class="bi bi-search"></i></div>
                    <div><h3 class="fw-bold mb-0">@Model.Count()</h3><small class="text-white-50">Reviewed Pitches</small></div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card d-flex align-items-center gap-3">
                    <div class="p-3 bg-success bg-opacity-10 text-success rounded-3 fs-3"><i class="bi bi-bookmark-check"></i></div>
                    <div><h3 class="fw-bold mb-0">0</h3><small class="text-white-50">Saved Startups</small></div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card d-flex align-items-center gap-3">
                    <div class="p-3 bg-info bg-opacity-10 text-info rounded-3 fs-3"><i class="bi bi-lightning-charge"></i></div>
                    <div><h3 class="fw-bold mb-0">0</h3><small class="text-white-50">Active Discussions</small></div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card d-flex align-items-center gap-3">
                    <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3 fs-3"><i class="bi bi-wallet2"></i></div>
                    <div><h3 class="fw-bold mb-0">$0</h3><small class="text-white-50">Committed Capital</small></div>
                </div>
            </div>
        </div>

        <!-- Explore Pitches Section -->
        <div class="glass-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <button class="btn btn-gradient rounded-pill px-4 py-2 fw-semibold">
                    <i class="bi bi-grid-fill me-2"></i>Explore Pitches
                </button>

                <!-- Search Form -->
                <form method="get" class="d-flex gap-2" style="max-width: 350px; width: 100%;">
                    <input type="hidden" name="category" value="@ViewBag.CurrentCategory" />
                    <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control form-control-custom" placeholder="Search startup name..." />
                    <button type="submit" class="btn btn-outline-custom rounded-3"><i class="bi bi-search"></i></button>
                </form>
            </div>

            <!-- Category Filter Pills -->
            <div class="d-flex flex-wrap gap-2 mb-4">
                <a href="?search=@ViewBag.CurrentSearch&category=" class="cat-badge @(string.IsNullOrEmpty(ViewBag.CurrentCategory) ? "active" : "")">All Categories</a>
                <a href="?search=@ViewBag.CurrentSearch&category=FinTech" class="cat-badge @(ViewBag.CurrentCategory == "FinTech" ? "active" : "")">FinTech</a>
                <a href="?search=@ViewBag.CurrentSearch&category=HealthTech" class="cat-badge @(ViewBag.CurrentCategory == "HealthTech" ? "active" : "")">HealthTech</a>
                <a href="?search=@ViewBag.CurrentSearch&category=EdTech" class="cat-badge @(ViewBag.CurrentCategory == "EdTech" ? "active" : "")">EdTech</a>
            </div>

            <!-- Pitch Cards List -->
            <div class="row g-4">
                @if (Model != null && Model.Any())
                {
                    @foreach (var pitch in Model)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="glass-card p-4 h-100 d-flex flex-column justify-content-between" style="background: rgba(255,255,255,0.02);">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <span class="badge bg-primary bg-opacity-20 text-primary border border-primary px-3 py-1 rounded-pill">@pitch.Category</span>
                                        <form asp-action="SaveStartup" method="post" class="d-inline">
                                            <input type="hidden" name="pitchId" value="@pitch.Id" />
                                            <button type="submit" class="btn btn-link text-white-50 p-0 border-0" title="Bookmark">
                                                <i class="bi bi-bookmark fs-5"></i>
                                            </button>
                                        </form>
                                    </div>
                                    <h5 class="fw-bold text-white mb-2">@pitch.StartupName</h5>
                                    <p class="text-white-50 small mb-4">@pitch.Tagline</p>
                                </div>

                                <div>
                                    <div class="row text-center py-2 border-top border-bottom border-white border-opacity-10 mb-3">
                                        <div class="col-6 border-end border-white border-opacity-10">
                                            <small class="text-white-50 d-block">Target</small>
                                            <span class="fw-bold text-white">$@pitch.TargetGoal.ToString("N0")</span>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-white-50 d-block">Equity</small>
                                            <span class="fw-bold text-white">@pitch.EquityOffered%</span>
                                        </div>
                                    </div>

                                    <form asp-action="RequestPitchDeck" method="post">
                                        <input type="hidden" name="pitchId" value="@pitch.Id" />
                                        <button type="submit" class="btn btn-gradient w-100 rounded-pill py-2 fw-semibold">
                                            <i class="bi bi-file-earmark-pdf me-1"></i> Request Pitch Deck
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <i class="bi bi-inbox fs-1 text-white-50 d-block mb-2"></i>
                        <p class="text-white-50">No startup pitches found matching your query.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>