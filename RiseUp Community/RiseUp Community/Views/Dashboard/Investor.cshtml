@model RiseUp_Community.Models.InvestorDashboardViewModel
@{
    ViewData["Title"] = "Investor Dashboard - RiseUp";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
            body {
                background: linear-gradient(135deg, #0b1020, #111827, #1e3a8a);
                color: #fff;
                font-family: 'Segoe UI', sans-serif;
                min-height: 100vh;
            }

            .glass {
                background: rgba(255, 255, 255, 0.07);
                backdrop-filter: blur(14px);
                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 20px;
            }

            .glass-card {
                transition: transform 0.3s ease, box-shadow 0.3s ease;
            }

                .glass-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
                }

            .gradient-text {
                background: linear-gradient(90deg, #38bdf8, #6366f1, #a855f7);
                -webkit-background-clip: text;
                color: transparent;
            }

            .stat-icon {
                width: 52px;
                height: 52px;
                border-radius: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.6rem;
            }

            .form-control-custom {
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.2);
                color: #fff !important;
                border-radius: 12px;
                padding: 10px 14px;
            }

                .form-control-custom option {
                    background-color: #111827;
                    color: #fff;
                }

            .nav-pills .nav-link {
                color: rgba(255,255,255,0.7);
                border-radius: 12px;
                padding: 10px 20px;
            }

                .nav-pills .nav-link.active {
                    background: linear-gradient(90deg, #6366f1, #a855f7);
                    color: #fff;
                }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg border-bottom border-white-10 py-3 sticky-top glass">
        <div class="container">
            <a class="navbar-brand fw-bold fs-3 text-white d-flex align-items-center" href="#">
                <i class="bi bi-rocket-takeoff-fill text-primary me-2"></i>Rise<span class="gradient-text">Up</span>
            </a>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill">
                    <i class="bi bi-cash-stack me-1"></i> Investor
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light rounded-pill px-3 py-1 btn-sm">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <main class="container py-4">

        <div class="glass p-4 p-md-5 mb-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <span class="badge bg-success bg-opacity-25 text-success px-3 py-2 rounded-pill mb-2">Dealflow Center</span>
                    <h1 class="fw-bold">Explore Promising <span class="gradient-text">Startups</span></h1>
                    <p class="text-white-50 mb-0">Discover high-potential pitches, request pitch decks, and manage investments.</p>
                </div>
            </div>
        </div>

        <!-- Dynamic Stat Cards -->
        <div class="row g-4 mb-4">
            <div class="col-md-3 col-sm-6">
                <div class="glass glass-card p-4 d-flex align-items-center">
                    <div class="stat-icon bg-primary bg-opacity-25 text-primary me-3"><i class="bi bi-search"></i></div>
                    <div><h3 class="fw-bold mb-0">@Model.ReviewedPitchesCount</h3><small class="text-white-50">Reviewed Pitches</small></div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="glass glass-card p-4 d-flex align-items-center">
                    <div class="stat-icon bg-success bg-opacity-25 text-success me-3"><i class="bi bi-bookmark-check-fill"></i></div>
                    <div><h3 class="fw-bold mb-0">@Model.SavedStartupsCount</h3><small class="text-white-50">Saved Startups</small></div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="glass glass-card p-4 d-flex align-items-center">
                    <div class="stat-icon bg-info bg-opacity-25 text-info me-3"><i class="bi bi-lightning-fill"></i></div>
                    <div><h3 class="fw-bold mb-0">@Model.ActiveDiscussionsCount</h3><small class="text-white-50">Active Discussions</small></div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="glass glass-card p-4 d-flex align-items-center">
                    <div class="stat-icon bg-warning bg-opacity-25 text-warning me-3"><i class="bi bi-wallet2"></i></div>
                    <div><h3 class="fw-bold mb-0">$@Model.CommittedCapital.ToString("N0")</h3><small class="text-white-50">Committed Capital</small></div>
                </div>
            </div>
        </div>

        <ul class="nav nav-pills mb-4 glass p-2 justify-content-start gap-2" id="investorTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" id="explore-tab" data-bs-toggle="tab" data-bs-target="#explore-content"><i class="bi bi-grid-fill me-1"></i> Explore Pitches</button>
            </li>
        </ul>

        <div class="tab-content" id="investorTabContent">
            <div class="tab-pane fade show active" id="explore-content">
                <form method="get" asp-action="Investor" class="glass p-4 mb-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <input type="text" name="search" class="form-control form-control-custom" placeholder="Search by industry, stage, or keyword..." />
                        </div>
                        <div class="col-md-3">
                            <select name="category" class="form-select form-control-custom">
                                <option>All Categories</option>
                                <option>FinTech</option>
                                <option>AI / Machine Learning</option>
                                <option>HealthTech</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100 rounded-pill"><i class="bi bi-funnel me-1"></i> Filter Deals</button>
                        </div>
                    </div>
                </form>

                <!-- Dynamic Pitch List -->
                <div class="row g-4">
                    @if (!Model.AvailablePitches.Any())
                    {
                        <div class="col-12 text-center text-white-50 py-5">
                            <p>No startups found matching your filter criteria.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var pitch in Model.AvailablePitches)
                        {
                            <div class="col-md-6">
                                <div class="glass glass-card p-4">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h4 class="fw-bold mb-0">@pitch.StartupName</h4>
                                        <span class="badge bg-primary">@pitch.Category</span>
                                    </div>
                                    <p class="text-white-50 small mb-3">@pitch.ShortDescription</p>
                                    <div class="d-flex justify-content-between text-sm text-white-50 border-top border-bottom border-white-10 py-2 mb-3">
                                        <span>Target: <strong>$@pitch.TargetAmount.ToString("N0")</strong></span>
                                        <span>Equity: <strong>@pitch.EquityOffered%</strong></span>
                                    </div>
                                    <div class="d-flex gap-2">
                                        @if (pitch.HasExpressedInterest)
                                        {
                                            <button class="btn btn-secondary btn-sm rounded-pill flex-fill" disabled><i class="bi bi-check-all me-1"></i> Interest Expressed</button>
                                        }
                                        else
                                        {
                                            <form asp-action="ExpressInterest" asp-route-pitchId="@pitch.Id" method="post" class="flex-fill">
                                                <button type="submit" class="btn btn-success btn-sm rounded-pill w-100"><i class="bi bi-check-circle me-1"></i> Express Interest</button>
                                            </form>
                                        }
                                        <a href="@pitch.PitchDeckUrl" target="_blank" class="btn btn-outline-light btn-sm rounded-pill flex-fill"><i class="bi bi-file-earmark-pdf me-1"></i> View Deck</a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>